# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── LaTeX build artifacts (keep .tex, .pdf; ignore build noise) ───────────────
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.blg
*.bbl

# ── TensorBoard / Training logs ────────────────────────────────────────────────
logs/
runs/
tensorboard/
*.tfevents.*

# ── Model checkpoints (large binaries) ────────────────────────────────────────
# models/ directory is tracked but zip/pkl inside can be ignored if large
*.zip
*.pkl
*.pt
*.pth

# ── IDE / OS ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ── Temp / scratch ────────────────────────────────────────────────────────────
*.tmp
*.bak
*~
